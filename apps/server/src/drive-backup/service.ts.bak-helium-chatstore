/**
 * Google-Drive-Sicherung: verbinden, sichern (Zeitplan + "Jetzt sichern"), auflisten, wiederherstellen.
 *
 * Reliability rules:
 *  - an upload counts only after Drive reports the same size and MD5 as the bytes we built,
 *  - the archive is opened and row-counted before upload (buildArchive),
 *  - one run at a time (in-process flag + Postgres advisory lock),
 *  - a restore first writes a full local safety copy of the current data, then replaces everything
 *    in one transaction,
 *  - errors are stored and shown in Settings; the scheduler simply tries again next tick.
 */
import { createHash } from "node:crypto";
import { mkdir, readdir, readFile, rm, writeFile } from "node:fs/promises";
import os from "node:os";
import path from "node:path";
import { sql } from "drizzle-orm";
import { decryptSecret, encryptSecret } from "../credentials";
import type { Database } from "../db/client";
import { brainRootFromEnv } from "../brain/store";
import {
  ArchiveError,
  type BackupSummary,
  buildArchive,
  changeFingerprint,
  collectFiles,
  keyFingerprint,
  openArchive,
  restoreDocument,
  restoreFiles,
} from "./archive";
import { DriveClient, type DriveFile, GoogleError, type OAuthClient, refreshAccessToken, revokeToken } from "./google";
import { type BackupRow, type BackupSettings, normaliseSettings, readRow, writeRow } from "./store";

export const CALLBACK_PATH = "/api/drive-backup/oauth/callback";

export type DriveBackupOptions = {
  database: Database;
  encryptionKey: string;
  /** Public origin of this API (redirect URI base). */
  publicUrl?: string;
  port: number;
  env?: NodeJS.ProcessEnv;
  fetchImpl?: typeof fetch;
  serverless?: boolean;
};

export function resolveClient(options: Pick<DriveBackupOptions, "publicUrl" | "port" | "env">): OAuthClient | null {
  const env = options.env ?? process.env;
  // Own pair first; otherwise the deployment's Google login client (a Desktop-type client accepts any
  // http://localhost:<port>/<path> loopback redirect, so local and App need no console change).
  const clientId = env.GOOGLE_DRIVE_CLIENT_ID?.trim() || env.GOOGLE_OAUTH_CLIENT_ID?.trim();
  const clientSecret = env.GOOGLE_DRIVE_CLIENT_ID?.trim()
    ? env.GOOGLE_DRIVE_CLIENT_SECRET?.trim()
    : env.GOOGLE_OAUTH_CLIENT_SECRET?.trim();
  if (!clientId || !clientSecret) return null;
  const base = (env.GOOGLE_DRIVE_REDIRECT_BASE?.trim() || options.publicUrl || `http://localhost:${options.port}`).replace(/\/+$/, "");
  return { clientId, clientSecret, redirectUri: env.GOOGLE_DRIVE_REDIRECT_URI?.trim() || `${base}${CALLBACK_PATH}` };
}

export function backupFileName(now: Date = new Date()): string {
  const p = (n: number) => String(n).padStart(2, "0");
  return `connect-backup-${now.getUTCFullYear()}${p(now.getUTCMonth() + 1)}${p(now.getUTCDate())}-${p(now.getUTCHours())}${p(now.getUTCMinutes())}${p(now.getUTCSeconds())}Z.cbk`;
}

/** Which Drive versions survive: the newest `keep`, plus the newest of each day for `keepDays`. */
export function retentionVictims(files: DriveFile[], settings: Pick<BackupSettings, "keep" | "keepDays">, now: number = Date.now()): DriveFile[] {
  const sorted = [...files].sort((a, b) => (b.createdTime ?? "").localeCompare(a.createdTime ?? ""));
  const keep = new Set(sorted.slice(0, settings.keep).map((f) => f.id));
  const perDay = new Set<string>();
  for (const f of sorted) {
    const t = Date.parse(f.createdTime ?? "");
    if (!Number.isFinite(t) || now - t > settings.keepDays * 86_400_000) continue;
    const day = new Date(t).toISOString().slice(0, 10);
    if (!perDay.has(day)) {
      perDay.add(day);
      keep.add(f.id);
    }
  }
  return sorted.filter((f) => !keep.has(f.id));
}

export type BackupStatus = {
  configured: boolean;
  redirectUri: string | null;
  clientIdHint: string | null;
  connected: boolean;
  email: string | null;
  connectedAt: string | null;
  folderName: string;
  settings: BackupSettings;
  running: boolean;
  scheduler: "on" | "off" | "serverless";
  lastAttemptAt: string | null;
  lastSuccessAt: string | null;
  lastFileName: string | null;
  lastSize: number | null;
  lastRows: number | null;
  lastTrigger: string | null;
  lastError: string | null;
  lastErrorAt: string | null;
  lastRestoreAt: string | null;
  lastRestoreInfo: string | null;
  keyFingerprint: string;
  localDir: string | null;
};

export function localBackupDir(env: NodeJS.ProcessEnv = process.env): string | null {
  const v = env.CONNECT_BACKUP_LOCAL_DIR?.trim();
  if (v === "off") return null;
  return v || path.join(os.homedir(), "Documents", "Connect-Backups", "drive-app");
}

export class DriveBackupService {
  private running = false;
  private timer: ReturnType<typeof setInterval> | null = null;
  readonly client: OAuthClient | null;
  private readonly env: NodeJS.ProcessEnv;
  private readonly fetchImpl: typeof fetch;

  constructor(private readonly options: DriveBackupOptions) {
    this.env = options.env ?? process.env;
    this.fetchImpl = options.fetchImpl ?? fetch;
    this.client = resolveClient(options);
  }

  get db() {
    return this.options.database;
  }

  async status(): Promise<BackupStatus> {
    const row = await readRow(this.db);
    return {
      configured: Boolean(this.client),
      redirectUri: this.client?.redirectUri ?? null,
      clientIdHint: this.client ? `${this.client.clientId.slice(0, 20)}…` : null,
      connected: Boolean(row?.refreshTokenEnc),
      email: row?.email ?? null,
      connectedAt: row?.connectedAt ?? null,
      folderName: "Connect Backup",
      settings: row?.settings ?? normaliseSettings(null),
      running: this.running,
      scheduler: this.options.serverless ? "serverless" : this.timer ? "on" : "off",
      lastAttemptAt: row?.lastAttemptAt ?? null,
      lastSuccessAt: row?.lastSuccessAt ?? null,
      lastFileName: row?.lastFileName ?? null,
      lastSize: row?.lastSize ?? null,
      lastRows: row?.lastRows ?? null,
      lastTrigger: row?.lastTrigger ?? null,
      lastError: row?.lastError ?? null,
      lastErrorAt: row?.lastErrorAt ?? null,
      lastRestoreAt: row?.lastRestoreAt ?? null,
      lastRestoreInfo: row?.lastRestoreInfo ?? null,
      keyFingerprint: keyFingerprint(this.options.encryptionKey),
      localDir: localBackupDir(this.env),
    };
  }

  async saveConnection(input: { userId: string; refreshToken: string; scope: string; email: string | null }) {
    const enc = await encryptSecret(this.options.encryptionKey, input.refreshToken);
    await writeRow(this.db, {
      ownerUserId: input.userId,
      refreshTokenEnc: enc,
      scope: input.scope,
      email: input.email,
      connectedAt: new Date().toISOString(),
      lastError: null,
      lastErrorAt: null,
    });
  }

  async disconnect(): Promise<void> {
    const row = await readRow(this.db);
    if (row?.refreshTokenEnc) {
      try {
        await revokeToken(await decryptSecret(this.options.encryptionKey, row.refreshTokenEnc), this.fetchImpl);
      } catch {
        /* revoke is best effort; the token is dropped here regardless */
      }
    }
    await writeRow(this.db, { refreshTokenEnc: null, email: null, connectedAt: null, scope: null });
  }

  async updateSettings(patch: Partial<BackupSettings>): Promise<BackupSettings> {
    const row = await readRow(this.db);
    const next = normaliseSettings({ ...(row?.settings ?? {}), ...patch });
    await writeRow(this.db, { settings: next });
    return next;
  }

  private async drive(row: BackupRow | null): Promise<DriveClient> {
    if (!this.client) throw new Error("Google-Drive-Sicherung ist nicht eingerichtet (Client-ID/Secret fehlen in der .env).");
    if (!row?.refreshTokenEnc) throw new Error("Google Drive ist nicht verbunden.");
    const refresh = await decryptSecret(this.options.encryptionKey, row.refreshTokenEnc);
    try {
      const token = await refreshAccessToken(this.client, refresh, this.fetchImpl);
      return new DriveClient(token.accessToken, this.fetchImpl);
    } catch (error) {
      if (error instanceof GoogleError && error.code === "invalid_grant") {
        throw new Error("Google hat den Zugriff widerrufen oder er ist abgelaufen. Bitte Google Drive neu verbinden.");
      }
      throw error;
    }
  }

  async connectedEmail(accessToken: string): Promise<string | null> {
    try {
      return (await new DriveClient(accessToken, this.fetchImpl).about()).email ?? null;
    } catch {
      return null;
    }
  }

  private async withLock<T>(fn: () => Promise<T>): Promise<T> {
    if (this.running) throw new Error("Eine Sicherung oder Wiederherstellung läuft bereits.");
    this.running = true;
    try {
      return await fn();
    } finally {
      this.running = false;
    }
  }

  private async archive() {
    return buildArchive(
      this.db,
      this.options.encryptionKey,
      { host: os.hostname(), app: this.env.CONNECT_APP_LABEL ?? `connect:${this.options.port}` },
      new Date(),
      await collectFiles(brainRootFromEnv(this.env)),
    );
  }

  /** Writes the archive into the local folder, keeping the newest `keep` there too. */
  async writeLocal(bytes: Uint8Array, name: string, keep = 10): Promise<string | null> {
    const dir = localBackupDir(this.env);
    if (!dir) return null;
    await mkdir(dir, { recursive: true });
    const file = path.join(dir, name);
    await writeFile(`${file}.part`, bytes);
    const { rename } = await import("node:fs/promises");
    await rename(`${file}.part`, file);
    const all = (await readdir(dir)).filter((f) => f.startsWith("connect-backup-") && f.endsWith(".cbk")).sort().reverse();
    for (const old of all.slice(keep)) await rm(path.join(dir, old), { force: true });
    return file;
  }

  /** Build + verify without uploading. Used by the CLI dry run and tests. */
  async dryRun(outFile?: string): Promise<BackupSummary & { file: string | null }> {
    const { bytes, summary } = await this.archive();
    let file: string | null = null;
    if (outFile) {
      await mkdir(path.dirname(outFile), { recursive: true });
      await writeFile(outFile, bytes);
      file = outFile;
    }
    return { ...summary, file };
  }

  async backupNow(trigger: string): Promise<{ file: DriveFile; summary: BackupSummary; trashed: number }> {
    return this.withLock(async () => {
      const startedAt = new Date().toISOString();
      await writeRow(this.db, { lastAttemptAt: startedAt });
      const locked = await this.tryAdvisoryLock();
      if (!locked) throw new Error("Eine andere Connect-Instanz sichert gerade dieselbe Datenbank.");
      try {
        const row = await readRow(this.db);
        const drive = await this.drive(row);
        const fingerprint = await changeFingerprint(this.db);
        const { bytes, summary } = await this.archive();
        const name = backupFileName();
        await this.writeLocal(bytes, name).catch(() => null);
        const folderId = await drive.ensureFolder(row?.folderId);
        const uploaded = await drive.upload({
          folderId,
          name,
          bytes,
          appProperties: {
            connectBackup: "1",
            format: "1",
            keyFp: keyFingerprint(this.options.encryptionKey),
            rows: String(summary.rows),
            tables: String(summary.tables),
            files: String(summary.files),
            trigger: trigger.slice(0, 40),
            source: (this.env.CONNECT_APP_LABEL ?? `connect:${this.options.port}`).slice(0, 60),
          },
        });
        // Verified upload: Drive must report exactly our size and MD5.
        const md5 = createHash("md5").update(bytes).digest("hex");
        const remote = (await drive.getFile(uploaded.id)) ?? uploaded;
        if (Number(remote.size) !== bytes.length || (remote.md5Checksum && remote.md5Checksum !== md5)) {
          throw new Error(`Upload-Prüfung fehlgeschlagen (Drive meldet ${remote.size} Bytes / MD5 ${remote.md5Checksum}).`);
        }
        let trashed = 0;
        try {
          const settings = row?.settings ?? normaliseSettings(null);
          for (const victim of retentionVictims(await drive.list(folderId), settings)) {
            if (victim.id === uploaded.id) continue;
            await drive.trash(victim.id);
            trashed += 1;
          }
        } catch {
          /* retention is retried next run; the new backup is safe already */
        }
        await writeRow(this.db, {
          folderId,
          lastSuccessAt: new Date().toISOString(),
          lastFileId: uploaded.id,
          lastFileName: name,
          lastSize: bytes.length,
          lastRows: summary.rows,
          lastTrigger: trigger,
          lastFingerprint: fingerprint,
          lastError: null,
          lastErrorAt: null,
        });
        return { file: uploaded, summary, trashed };
      } catch (error) {
        await writeRow(this.db, {
          lastError: (error instanceof Error ? error.message : String(error)).slice(0, 500),
          lastErrorAt: new Date().toISOString(),
        });
        throw error;
      } finally {
        await this.releaseAdvisoryLock();
      }
    });
  }

  async list(): Promise<DriveFile[]> {
    const row = await readRow(this.db);
    const drive = await this.drive(row);
    if (!row?.folderId) return [];
    return drive.list(row.folderId);
  }

  async restore(fileId: string): Promise<{ restored: Awaited<ReturnType<typeof restoreDocument>>; safetyCopy: string | null; brainDir: string | null; brainFiles: number }> {
    return this.withLock(async () => {
      const row = await readRow(this.db);
      const drive = await this.drive(row);
      const meta = await drive.getFile(fileId);
      if (!meta || meta.appProperties?.connectBackup !== "1") throw new ArchiveError("Diese Datei ist keine Connect-Sicherung.");
      const bytes = await drive.download(fileId);
      const doc = await openArchive(bytes, this.options.encryptionKey);
      // Safety copy of the CURRENT data first; a restore without it does not start.
      const { bytes: current } = await this.archive();
      const stamp = new Date().toISOString().replace(/[-:]/g, "").replace(/\..+/, "");
      const safetyCopy = await this.writeLocal(current, `connect-backup-${stamp}Z-vor-wiederherstellung.cbk`, 50);
      if (!safetyCopy) throw new Error("Ohne lokale Sicherheitskopie wird nicht wiederhergestellt (CONNECT_BACKUP_LOCAL_DIR=off).");
      const restored = await restoreDocument(this.db, doc);
      let brainDir: string | null = null;
      let brainFiles = 0;
      const brainRoot = brainRootFromEnv(this.env);
      if (doc.files && Object.keys(doc.files).length && brainRoot) {
        brainDir = `${brainRoot}-Wiederherstellung-${stamp}`;
        brainFiles = await restoreFiles(doc.files, brainDir);
      }
      await writeRow(this.db, {
        lastRestoreAt: new Date().toISOString(),
        lastRestoreInfo: `${meta.name}: ${restored.tables} Tabellen, ${restored.rows} Zeilen${brainFiles ? `, ${brainFiles} Brain-Dateien nach ${brainDir}` : ""}`,
      });
      return { restored, safetyCopy, brainDir, brainFiles };
    });
  }

  /** Restore from a local .cbk file (e.g. the safety copy), same rules. */
  async restoreLocal(file: string) {
    return this.withLock(async () => {
      const doc = await openArchive(new Uint8Array(await readFile(file)), this.options.encryptionKey);
      return restoreDocument(this.db, doc);
    });
  }

  /** A 15-minute lease row instead of a session advisory lock (pooled connections would leak it). */
  private async tryAdvisoryLock(): Promise<boolean> {
    await writeRow(this.db, {});
    const result = (await this.db.execute(sql`UPDATE connect_drive_backup SET lease_until = now() + interval '15 minutes'
      WHERE id = 'default' AND (lease_until IS NULL OR lease_until < now()) RETURNING id`)) as unknown;
    const rows = Array.isArray(result) ? result : ((result as { rows?: unknown[] }).rows ?? []);
    return rows.length > 0;
  }

  private async releaseAdvisoryLock(): Promise<void> {
    await this.db.execute(sql`UPDATE connect_drive_backup SET lease_until = NULL WHERE id = 'default'`).catch(() => undefined);
  }

  /** Decides whether the scheduler should back up now. Exported for tests. */
  static due(row: BackupRow | null, fingerprint: string, now: number = Date.now()): string | null {
    if (!row?.refreshTokenEnc || !row.settings.enabled) return null;
    const last = row.lastSuccessAt ? Date.parse(row.lastSuccessAt) : 0;
    const lastTry = row.lastAttemptAt ? Date.parse(row.lastAttemptAt) : 0;
    // After a failure, wait 10 minutes before trying again.
    if (row.lastErrorAt && now - lastTry < 10 * 60_000) return null;
    if (!last) return "erste Sicherung";
    if (fingerprint !== row.lastFingerprint && now - last >= row.settings.minIntervalMinutes * 60_000) return "Änderung";
    if (now - last >= row.settings.maxAgeHours * 3_600_000) return "Zeitplan";
    return null;
  }

  startScheduler(intervalMs = 5 * 60_000): void {
    if (this.options.serverless || this.timer || this.env.CONNECT_DRIVE_BACKUP_SCHEDULER === "off") return;
    const tick = async () => {
      if (this.running) return;
      try {
        const row = await readRow(this.db);
        const reason = DriveBackupService.due(row, await changeFingerprint(this.db));
        if (reason) await this.backupNow(reason);
      } catch (error) {
        console.warn(`[drive-backup] ${error instanceof Error ? error.message : String(error)}`);
      }
    };
    this.timer = setInterval(() => void tick(), intervalMs);
    (this.timer as { unref?: () => void }).unref?.();
    setTimeout(() => void tick(), 60_000).unref?.();
  }
}
