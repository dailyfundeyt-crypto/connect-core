/**
 * Collapsed icon rail â€” show Ordner (folder tiles). Click opens apps in a
 * vertical row underneath, same idea as Unternehmen Gruppen.
 */
/** Groups nested under `groupId`, found by walking the flat stored list. */
function railGroupIds(state: Level3BrowserState, groupId: string): string[] {
  const all = normalizeGroups(state.tabGroups);
  const byParent = new Map<string, string[]>();
  for (const g of all) {
    if (!g.parentId) continue;
    const list = byParent.get(g.parentId) ?? [];
    list.push(g.id);
    byParent.set(g.parentId, list);
  }
  const out: string[] = [];
  const walk = (id: string) => {
    for (const child of byParent.get(id) ?? []) {
      out.push(child);
      walk(child);
    }
  };
  walk(groupId);
  return out;
}

export function LabIconRail({
  companyId,
  className,
}: {
  companyId: string | null;
  className?: string;
}) {
  const [state, setState] = useState(() =>
    companyId ? getLevel3Browser(companyId) : null,
  );

  useEffect(() => {
    if (!companyId) return;
    setState(getLevel3Browser(companyId));
    return subscribeLevel3Browser(() =>
      setState(getLevel3Browser(companyId)),
    );
  }, [companyId]);

  if (!companyId || !state) return null;

  // The rail must walk the same nested tree the expanded sidebar uses. It used labAppsByGroup(),
  // which is flat, so a subfolder rendered as its own top-level icon instead of sitting indented
  // under its parent -- the parent looked like it contained nothing.
  const { roots, ungrouped } = labFolderTree(state);

  return (
    <div
      className={cn(
        "flex min-h-0 w-full flex-1 flex-col items-center gap-1.5 overflow-y-auto pt-1 pb-2",
        className,
      )}
    >
      {roots.length === 0 && ungrouped.length === 0 ? (
        <span
          className="flex size-9 items-center justify-center rounded-[10px] bg-sky-100 text-sky-700 ring-1 ring-sky-200/80"
          title="Keine Gruppen"
        >
          <IconFolder className="size-4" />
        </span>
      ) : null}

      <RailTree
        companyId={companyId}
        depth={0}
        nodes={roots}
        onChange={setState}
        state={state}
      />

      {ungrouped.length > 0 ? (
        <div className="mt-1 flex flex-col items-center gap-1">
          {roots.length > 0 ? (
            <span className="my-0.5 h-px w-5 bg-sidebar-border/80" />
          ) : null}
          {ungrouped.map((app) => {
            const active = !state.starred && state.activeTool === app.id;
            return (
              <Tooltip key={app.id}>
                <TooltipTrigger
                  render={
                    <button
                      aria-label={app.label}
                      className={cn(
                        "flex size-8 items-center justify-center rounded-lg transition-colors",
                        active
                          ? "bg-sidebar-accent shadow-[inset_0_0_0_1px_var(--sidebar-border)]"
                          : "hover:bg-sidebar-accent/60",
                      )}
                      onClick={() =>
                        setState(openLabApp(companyId, app.id))
                      }
                      type="button"
                    >
                      <ToolGlyph icon={app.icon} tint={app.tint} />
                    </button>
                  }
                />
                <TooltipContent side="right">{app.label}</TooltipContent>
              </Tooltip>
            );
          })}
        </div>
      ) : null}
    </div>
  );
}

/**
 * Icon-rail folder tree, recursing into children.
 *
 * The rail rendered labAppsByGroup().groups -- a flat list -- so a subfolder appeared as its own
 * top-level icon instead of indented under the folder it belongs to, and the parent looked empty.
 * Indent is a thin left rule plus a slight shrink: the rail is only ~44px wide, so the child
 * icons move right by 8px rather than by a full level, which would push them out of view.
 */
function RailTree({
  companyId,
  nodes,
  depth,
  state,
  onChange,
}: {
  companyId: string;
  nodes: LabFolderNode[];
  depth: number;
  state: Level3BrowserState;
  onChange: (next: Level3BrowserState) => void;
}) {
  return (
    <ul
      className={cn(
        "flex w-full flex-col items-center gap-1.5",
        depth > 0 && "ml-2 border-l border-sidebar-border/50 pl-1",
      )}
    >
      {nodes.map((group) => {
        const open = !group.collapsed;
        const deep = countAppsDeep(group);
        // Drawn from the whole subtree, so a folder that only holds subfolders still gets a real
        // 2x2 preview instead of the abstract fallback glyph.
        const preview = previewAppsDeep(group);
        const deleteRailGroup = () => {
          // Deleting from the rail removes the folder and everything under it, so the prompt
          // counts the whole subtree rather than just this folder's own apps.
          const kids = railGroupIds(state, group.id);
          const msg =
            deep > 0
              ? `Gruppe "${group.label}" löschen? Die ${deep} App(s) und ${kids.length} Untergruppe(n) gehen verloren.`
              : `Gruppe "${group.label}" löschen?`;
          if (!window.confirm(msg)) return;
          onChange(setTabGroupOpen(companyId, group.id, false));
