              </ContextMenuItem>
            </>
          ) : conn ? (
            <>
              <ContextMenuSeparator />
              <ContextMenuItem
                className="gap-2 rounded-lg px-2.5 py-2"
                onClick={() => onChange(disconnectTool(companyId, app.id))}
