/**
 * Renders the folder tree, recursing into children.
 *
 * The list used to map over labAppsByGroup().groups, which is a flat list -- a folder created
 * inside another one got a parentId but was still rendered as a top-level sibling, so nesting was
 * impossible to see or use. labFolderTree() already resolved parentId into a real tree; nothing
 * called it. Folders can now nest, and each level indents its children.
 */
function FolderTree({
  companyId,
  nodes,
  depth,
  groupIds,
  groupsById,
  state,
  dragOverId,
  setDragOverId,
  onChange,
  onConnect,
  onEdit,
  onCreateChild,
}: {
  companyId: string;
  nodes: LabFolderNode[];
  depth: number;
  /** Flat display order of all group ids, used when a folder is dragged to reorder. */
  groupIds: string[];
  /**
   * Every group in the tree by id, so a drag can be resolved no matter which nesting level the
   * pointer is over. `nodes` only holds the siblings of this level.
   */
  groupsById: Map<string, LabFolderNode>;
  state: Level3BrowserState;
  dragOverId: string | null;
  /** Accepts an updater so a drag leaving one folder does not clear a sibling it just entered. */
  setDragOverId: (id: string | null | ((prev: string | null) => string | null)) => void;
  onChange: (next: Level3BrowserState) => void;
  onConnect: (id: string) => void;
  onEdit: (id: string) => void;
  onCreateChild: (parentId: string) => void;
}) {
  return (
    <ul
      className={cn(
        "flex flex-col gap-0.5",
        depth > 0 && "ml-3 border-l border-sidebar-border/50 pl-1.5",
        // A nested folder dragged to the far left of this list leaves its parent, so the gesture is
        // a sideways pull out of the tree rather than a drop onto a target row.
        dragOverId === "detach" && "bg-sky-400/8 outline-1 -outline-offset-1 outline-sky-400/40",
      )}
      onDragOver={(event) => {
        const types = [...event.dataTransfer.types];
        const groupId = event.dataTransfer.getData(DND_LAB_GROUP);
        if (!types.includes(DND_LAB_GROUP) || !groupId) return;
        // A folder can be pulled out anywhere over the list. Scoping this to a left-hand strip
        // looked tidier, but the nested list is itself indented, so the strip did not line up with
        // the dragged row on deeper levels.
        const target = groupsById.get(groupId);
        if (!target?.parentId) return;
        event.preventDefault();
        event.stopPropagation();
        event.dataTransfer.dropEffect = "move";
        setDragOverId("detach");
      }}
      onDragLeave={(event) => {
        if (event.currentTarget.contains(event.relatedTarget as Node)) return;
        setDragOverId((id) => (id === "detach" ? null : id));
      }}
      onDrop={(event) => {
        const groupId = event.dataTransfer.getData(DND_LAB_GROUP);
        if (dragOverId !== "detach" || !groupId) return;
        event.preventDefault();
        event.stopPropagation();
        setDragOverId(null);
        onChange(moveTabGroupToRoot(companyId, groupId));
      }}
    >
      {nodes.map((group) => {
        const open = !group.collapsed;
        const folderDrop = dragOverId === `group:${group.id}`;
        const childCount = countAppsDeep(group);
        return (
          <li key={group.id}>
            <ContextMenu>
              <ContextMenuTrigger
                className={cn(
                  "group/folder relative flex w-full items-center gap-2.5 rounded-xl px-2 py-1.5 text-left transition-colors hover:bg-sidebar-accent",
                  folderDrop && "bg-sidebar-accent ring-1 ring-sky-400/50",
                )}
                onClick={() =>
                  onChange(setTabGroupOpen(companyId, group.id, !open))
                }
                // Only the handle starts a drag. Making the whole row draggable meant every
                // attempt to reorder began by grabbing the row that also toggles the folder, and
                // the click that followed a short drag kept flipping it.
                draggable={false}
                onDragOver={(event) => {
                  const types = [...event.dataTransfer.types];
                  if (
                    !types.includes(DND_LAB_GROUP) &&
                    !types.includes(DND_LAB_APP)
                  ) {
                    return;
                  }
                  event.preventDefault();
                  event.dataTransfer.dropEffect = "move";
                  setDragOverId(`group:${group.id}`);
                }}
                onDragLeave={() =>
                  setDragOverId((id) =>
                    id === `group:${group.id}` ? null : id,
                  )
                }
                onDrop={(event) => {
                  event.preventDefault();
                  setDragOverId(null);
                  const groupId = event.dataTransfer.getData(DND_LAB_GROUP);
                  const appId = event.dataTransfer.getData(DND_LAB_APP);
                  if (appId) {
                    // An app always lands inside the folder; the row has no "before/after" meaning
                    // for it.
                    onChange(moveAppToGroup(companyId, appId, group.id));
                    onChange(setTabGroupOpen(companyId, group.id, true));
                    return;
                  }
                  if (!groupId) return;
                  if (groupId === group.id) return;
                  // The pointer position decides: top half reorders above, bottom half below.
                  // Dropping onto the middle of a row used to always mean "before", which made
                  // the last entry impossible to reach.
                  const rect = event.currentTarget.getBoundingClientRect();
                  const after = event.clientY > rect.top + rect.height / 2;
                  const inside = depth === 0 && group.children.length === 0 && after;
                  if (inside) {
                    // A dedicated "move into" gesture for an empty top-level folder keeps the two
                    // meanings apart: over the centre nests, over an edge reorders.
                    onChange(moveTabGroupIntoGroup(companyId, groupId, group.id));
                    onChange(setTabGroupOpen(companyId, group.id, true));
                    return;
                  }
                  onChange(
                    reorderTabGroups(
                      companyId,
                      moveIdToSlot(groupIds, groupId, group.id, after),
                    ),
                  );
                }}
              >
                <button
                  aria-label={`${group.label} verschieben`}
                  className="-ml-1 flex size-6 shrink-0 cursor-grab items-center justify-center rounded-md text-sidebar-foreground/25 opacity-0 transition-opacity hover:bg-sidebar-accent hover:text-sidebar-foreground/70 focus-visible:opacity-100 group-hover/folder:opacity-100 active:cursor-grabbing"
                  draggable
                  onClick={(event) => {
                    // Without this the drag handle's click also toggled the folder underneath.
                    event.stopPropagation();
                  }}
                  onDragEnd={() => setDragOverId(null)}
                  onDragStart={(event) => {
                    event.stopPropagation();
                    event.dataTransfer.setData(DND_LAB_GROUP, group.id);
                    event.dataTransfer.effectAllowed = "move";
                  }}
                  type="button"
                >
                  <IconGripVertical className="size-3.5" />
                </button>
                <LabFolderIcon apps={group.apps} />
                <span className="min-w-0 flex-1">
                  <span className="block truncate text-[13px] font-medium tracking-tight">
                    {group.label}
                  </span>
                </span>
                <span className="ml-1 inline-flex h-5 min-w-5 shrink-0 items-center justify-center rounded-full bg-sidebar-foreground/10 px-1.5 text-[10px] font-semibold tabular-nums text-sidebar-foreground/60">
                  {childCount}
                </span>
                <ChevronDownIcon open={open} className="ml-1" />
              </ContextMenuTrigger>
              <ContextMenuContent className="min-w-52 rounded-xl p-1.5">
                <ContextMenuItem
                  className="gap-2 rounded-lg px-2.5 py-2"
                  onClick={() => onChange(setTabGroupOpen(companyId, group.id, true))}
                >
                  <IconFolder className="size-4" />
                  Ã–ffnen
                </ContextMenuItem>
                <ContextMenuItem
                  className="gap-2 rounded-lg px-2.5 py-2"
                  onClick={() => {
                    const next = window.prompt("Name der Gruppe?", group.label);
                    if (!next?.trim()) return;
                    onChange(renameTabGroup(companyId, group.id, next));
                  }}
                >
                  <IconPencil className="size-4" />
                  Umbenennen
                </ContextMenuItem>
                <ContextMenuItem
                  className="gap-2 rounded-lg px-2.5 py-2"
                  onClick={() => onCreateChild(group.id)}
                >
                  <IconFolderPlus className="size-4" />
                  Neue Untergruppe
                </ContextMenuItem>
                <ContextMenuSeparator />
                <ContextMenuItem
                  className="gap-2 rounded-lg px-2.5 py-2 text-destructive focus:text-destructive"
                  onClick={() => {
                    const msg =
                      childCount > 0
                        ? `Gruppe â€ž${group.label}" lÃ¶schen? Die ${childCount} App(s) und ${group.children.length} Untergruppe(n) gehen verloren.`
                        : `Gruppe â€ž${group.label}" lÃ¶schen?`;
                    if (!window.confirm(msg)) return;
                    const doomed = collectGroupIds(group);
                    let next = setTabGroupOpen(companyId, group.id, false);
                    for (const id of doomed) next = deleteTabGroup(companyId, id);
                    onChange(next);
                  }}
                >
                  <IconTrash className="size-4" />
                  Gruppe lÃ¶schen
                </ContextMenuItem>
              </ContextMenuContent>
            </ContextMenu>
            {open ? (
              <>
                {group.apps.length > 0 ? (
                  <ul className="mt-0.5 flex flex-col gap-0.5">
                    {group.apps.map((app) => (
                      <AppRow
                        app={app}
                        companyId={companyId}
                        dragOverId={dragOverId}
                        groupId={group.id}
                        key={app.id}
                        onChange={onChange}
                        onConnect={onConnect}
                        onEdit={onEdit}
                        setDragOverId={setDragOverId}
                        state={state}
                      />
                    ))}
                  </ul>
                ) : null}
                {group.children.length > 0 ? (
                  <FolderTree
                    companyId={companyId}
                    depth={depth + 1}
                    dragOverId={dragOverId}
                    groupIds={groupIds}
                    groupsById={groupsById}
                    nodes={group.children}
                    onChange={onChange}
                    onConnect={onConnect}
                    onCreateChild={onCreateChild}
                    onEdit={onEdit}
                    setDragOverId={setDragOverId}
                    state={state}
                  />
                ) : null}
              </>
            ) : null}
          </li>
        );
      })}
    </ul>
  );
}

/** Apps in this folder plus every app in its descendants, for the count badge. */
function countAppsDeep(node: LabFolderNode): number {
  return (
    node.apps.length +
    node.children.reduce((sum, child) => sum + countAppsDeep(child), 0)
  );
}

/**
 * Apps a folder stands for, including those in its subfolders.
 *
 * The collapsed rail has only room for one 2x2 preview per folder. A folder whose apps all sit in
 * subfolders used to fall back to an abstract glyph, so collapsing the sidebar hid what the folder
 * actually contained. Taking the subtree makes the icon match the expanded sidebar.
 */
function previewAppsDeep(node: LabFolderNode, limit = 4): LabApp[] {
  const out: LabApp[] = [];
  const walk = (current: LabFolderNode) => {
    for (const app of current.apps) {
      if (out.length < limit) out.push(app);
    }
    for (const child of current.children) {
      walk(child);
    }
  };
  walk(node);
  return out;
}

/** The folder itself and all folders beneath it -- what a delete has to remove. */
function collectGroupIds(node: LabFolderNode): string[] {
  return [node.id, ...node.children.flatMap(collectGroupIds)];
}

/** True when `candidateId` sits somewhere under `node`, so re-parenting would make a cycle. */
function isDescendantOf(node: LabFolderNode, candidateId: string): boolean {
  return node.children.some(
    (child) => child.id === candidateId || isDescendantOf(child, candidateId),
  );
}

function LabFolderIcon({
  apps,
  size = "size-9",
}: {
  apps: LabApp[];
  /** The collapsed rail is only ~44px wide, so its tiles are rendered a little larger. */
  size?: "size-9" | "size-10";
}) {
  const preview = apps.slice(0, 4);
  // An empty folder used to render four translucent placeholder cells, which read as washed out and
  // gave no hint what the tile was. A solid folder glyph keeps the tile legible when there is
  // nothing to preview.
  const empty = preview.length === 0;
  return (
    <span
      aria-hidden
      className={cn(
        "relative flex shrink-0 items-center justify-center overflow-hidden rounded-[10px]",
        size,
        "bg-gradient-to-b from-[#7ec8f5] to-[#3b9de0] shadow-sm ring-1 ring-black/10",
      )}
    >
      {empty ? (
        <IconFolder
          className="relative size-[55%] text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.28)]"
          stroke={2}
        />
      ) : (
      <span className="absolute inset-[3px] grid grid-cols-2 grid-rows-2 gap-[2px] overflow-hidden rounded-[7px] bg-white/25 p-[2px]">
        {Array.from({ length: 4 }).map((_, i) => {
          const app = preview[i];
          if (!app) {
            return (
              <span className="rounded-[3px] bg-white/35" key={`empty-${i}`} />
            );
          }
          return (
            <span
              className="flex items-center justify-center overflow-hidden rounded-[3px] bg-white/70"
              key={app.id}
            >
              <ToolGlyph compact icon={app.icon} tint={app.tint} />
            </span>
          );
        })}
      </span>
      )}
    </span>
  );
}

function ToolGlyph({
  icon,
  tint,
  compact = false,
}: {
  icon: string;
  tint: string;
  /** Preview cells in LabFolderIcon are ~13px wide, far smaller than a normal 28px row. */
  compact?: boolean;
}) {
  const [failed, setFailed] = useState(false);
  const box = compact
    ? "flex size-full items-center justify-center overflow-hidden rounded-[3px]"
    : "flex size-7 shrink-0 items-center justify-center overflow-hidden rounded-md bg-white ring-1 ring-black/5";
  if (failed) {
    return (
      <span
        className={cn(
          compact
            ? "flex size-full items-center justify-center rounded-[3px]"
            : "flex size-7 shrink-0 items-center justify-center rounded-md",
        )}
        style={{ backgroundColor: `${tint}18` }}
      >
        <IconDiamond
          className={compact ? "size-2" : "size-3.5 text-sidebar-foreground/50"}
          stroke={1.5}
        />
      </span>
    );
  }
  return (
    <span className={box}>
      <img
        alt=""
        className={compact ? "size-2.5 object-contain" : "size-4 object-contain"}
        onError={() => setFailed(true)}
        src={toolIconUrl(icon)}
      />
    </span>
  );
}

