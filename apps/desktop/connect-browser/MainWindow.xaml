<Window x:Class="ConnectDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Connect"
        Width="1480"
        Height="920"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI"
        KeyDown="Window_KeyDown"
        Focusable="True"
        xmlns:app="clr-namespace:ConnectDesktop"
        xmlns:local="clr-namespace:ConnectDesktop"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <!-- App-wide Keyboard Shortcuts werden in MainWindow.KeyDown abgefangen.
       Begründung: einfacher, weniger Klassen, gleiche Wirkung. -->

  <Window.Resources>
    <ResourceDictionary>
      <!-- Sidebar round image button -->
      <Style TargetType="RadioButton" x:Key="ModeChip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SideFgMuted}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      CornerRadius="8">
                <Path Data="{TemplateBinding Tag}"
                      Stretch="Uniform"
                      Width="16" Height="16"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent" SnapsToDevicePixels="True"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideRowHover}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideAccent}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SideBorder}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                  <Setter Property="Foreground" Value="{DynamicResource SideFg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Sidebar Level-Chip: aktiver Level (web spec: inset-shadow + sidebar-border ring) -->
      <Style TargetType="RadioButton" x:Key="LevelChip" BasedOn="{StaticResource ModeChip}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
      </Style>

      <!-- Converter für Bool → Visibility — MUSS vor allen DataTemplates definiert sein,
           sonst findet StaticResource ihn nicht zur Parse-Zeit. -->
      <local:BoolToVisibleConverter x:Key="BoolToVisible"/>

      <!-- DataTemplate für SidebarItem: Avatar + Name + Subtitle + Pin/Unread-Indikatoren -->
      <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type local:SidebarItem}">
        <Grid Margin="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Avatar (32×32) -->
          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" ClipToBounds="True"
                  Background="{DynamicResource SideAccent}" Margin="0,0,10,0" VerticalAlignment="Center">
            <Image Source="{Binding AvatarSource}" Stretch="UniformToFill"/>
          </Border>

          <!-- Name + Subtitle -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource SideFg}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
              <Border CornerRadius="3" Padding="3,1" Margin="6,0,0,0"
                      Background="#F59E0B" VerticalAlignment="Center"
                      Visibility="{Binding Pinned, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="📌" FontSize="9" Foreground="White"/>
              </Border>
              <Border CornerRadius="3" Padding="3,1" Margin="4,0,0,0"
                      Background="{DynamicResource AccentGreen}" VerticalAlignment="Center"
                      Visibility="{Binding Online, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="online" FontSize="8" Foreground="White" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                       Foreground="{DynamicResource SideFgMuted}" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
          </StackPanel>

          <!-- Unread-Dot / Last-At -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="{Binding LastAt}" FontSize="10"
                       Foreground="{DynamicResource SideFgMuted}" VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentGreen}" VerticalAlignment="Center"
                     Visibility="{Binding Unread, Converter={StaticResource BoolToVisible}}"/>
          </StackPanel>
        </Grid>
      </DataTemplate>

      <!-- Sidebar round icon button (32x32) -->
      <Style TargetType="Button" x:Key="SideIconBtn">
        <Setter Property="Background" Value="{DynamicResource SideRowHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource SideFg}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                <Path Data="{TemplateBinding Tag}"
                      Stretch="Uniform"
                      Width="14" Height="14"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      SnapsToDevicePixels="True"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideAccent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Channel row in the roster -->
      <Style TargetType="ListBoxItem" x:Key="ChannelRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      CornerRadius="10"
                      Margin="6,1"
                      Padding="10,7">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideRowHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideRowActive}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Toolbar icon button (34x34, soft pill, with accent glow on hover/pressed) -->
      <Style TargetType="Button" x:Key="ToolbarIconBtn">
        <Setter Property="Foreground" Value="{DynamicResource SideFg}"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" CornerRadius="10"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <Path Data="{TemplateBinding Tag}"
                      Stretch="Uniform"
                      Width="15" Height="15"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      SnapsToDevicePixels="True"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideRowHover}"/>
                  <Setter Property="Foreground" Value="{DynamicResource SideAccent}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideRowActive}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Address-bar back/forward/reload button (28x28) -->
      <Style TargetType="Button" x:Key="NavIconBtn" BasedOn="{StaticResource ToolbarIconBtn}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0"/>
      </Style>

    </ResourceDictionary>
  </Window.Resources>

  <!-- ===================== ROOT LAYOUT =====================
       Drei Spalten:
         0) WPF-Sidebar (Default 0px, ausgeblendet — WebApp hat eigene Sidebar)
         1) WebApp + Top-Rail + Status (Default: fullscreen, Connect-Web)
         2) Echt-Browser im Split (Default 0px, nur sichtbar wenn User es öffnet)
  -->
  <Grid x:Name="RootGrid" Background="{DynamicResource Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="0"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0" x:Name="WpfSidebarColumn" MinWidth="0"/>
      <ColumnDefinition Width="*" x:Name="WebAppColumn" MinWidth="400"/>
      <ColumnDefinition Width="Auto" x:Name="SplitterColumn"/>
      <ColumnDefinition Width="0" x:Name="BrowserSplitColumn" MinWidth="0"/>
    </Grid.ColumnDefinitions>


    <!-- ===================== WPF SIDEBAR (Default Collapsed) ===================== -->
    <Grid Grid.Row="1" Grid.Column="0"
          x:Name="SidebarRoot"
          Background="{DynamicResource SideBg}"
          Width="280"
          MinWidth="60"
          Visibility="Collapsed"
          SizeChanged="SidebarRoot_SizeChanged">
      <DockPanel>

        <!-- Sidebar Header -->
        <Border DockPanel.Dock="Top" Padding="10,10,10,8"
                BorderBrush="{DynamicResource SideBorder}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="ConnectBrandMark" Width="22" Height="22"
                    CornerRadius="6" Cursor="Hand" ToolTip="Connect"
                    MouseLeftButtonUp="ConnectBrandMark_Click" VerticalAlignment="Center"
                    Background="{DynamicResource SideBg}"
                    BorderBrush="{DynamicResource SideBorder}" BorderThickness="1">
              <TextBlock Text="C" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource SideFg}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel x:Name="HeaderContentPanel" Grid.Column="1" Orientation="Horizontal"
                        Margin="6,0,0,0" VerticalAlignment="Center">
              <RadioButton x:Name="LevelFocus"   Style="{StaticResource LevelChip}" GroupName="Level"
                           Tag="{DynamicResource Icon.Bolt}" ToolTip="Focus" Checked="LevelFocus_Checked"/>
              <RadioButton x:Name="LevelChat"    Style="{StaticResource LevelChip}" GroupName="Level"
                           Tag="{DynamicResource Icon.Messages}" ToolTip="Chat" Checked="LevelChat_Checked"/>
              <RadioButton x:Name="LevelBrowser" Style="{StaticResource LevelChip}" GroupName="Level"
                           Tag="{DynamicResource Icon.Browser}" ToolTip="Browser" Checked="LevelBrowser_Checked"/>
              <RadioButton x:Name="LevelCompany" Style="{StaticResource LevelChip}" GroupName="Level"
                           Tag="{DynamicResource Icon.Building}" ToolTip="Unternehmen" Checked="LevelCompany_Checked"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="BtnCollapse"
                    Margin="6,0,0,0" VerticalAlignment="Center"
                    Click="BtnCollapse_Click" ToolTip="Sidebar einklappen (Ctrl+B)"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
              <Path x:Name="CollapseIcon" Width="14" Height="14"
                    Stroke="{DynamicResource SideFgMuted}" StrokeThickness="1.75"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Fill="Transparent"
                    Data="M15 18l-6-6 6-6"
                    SnapsToDevicePixels="True"/>
            </Button>
          </Grid>
        </Border>

        <!-- Search + Plus -->
        <Border DockPanel.Dock="Top" x:Name="SearchPanel" Padding="10,8,10,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SideRowHover}" CornerRadius="8" Padding="8,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="14" Height="14"
                      Stroke="{DynamicResource SideFgMuted}" StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M3 10a7 7 0 1 0 14 0a7 7 0 1 0-14 0 M21 21l-6-6"
                      Fill="Transparent" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" x:Name="SidebarSearch"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource SideFg}"
                         CaretBrush="{DynamicResource SideAccent}"
                         FontSize="12" VerticalContentAlignment="Center"
                         TextChanged="SidebarSearch_TextChanged"/>
              </Grid>
            </Border>
            <Button Grid.Column="1" x:Name="BtnCreate" Style="{StaticResource SideIconBtn}"
                    Tag="{DynamicResource Icon.Plus}" Margin="4,0,0,0" Click="BtnCreate_Click"
                    ToolTip="Erstellen…"/>
          </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" x:Name="FooterPanel"
                Padding="10,8,10,10"
                BorderBrush="{DynamicResource SideBorder}" BorderThickness="0,1,0,0">
          <StackPanel>
            <Border x:Name="AiBridgePill" Padding="8,6" CornerRadius="8" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="AiBridgeLed" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="AiBridgeIcon" Text="✦" FontSize="11" Margin="0,0,4,0"
                           Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center"/>
                <TextBlock x:Name="AiServerStatus" Text="AI-Bridge: verbunden"
                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border x:Name="UserMenuBorder" Cursor="Hand" MouseLeftButtonUp="UserMenu_Click"
                    Background="Transparent" CornerRadius="10" Padding="4">
              <Border.ContextMenu>
                <ContextMenu x:Name="UserMenuCtx">
                  <MenuItem Header="Profil — Stefan Kunc" IsEnabled="False"/>
                  <Separator/>
                  <MenuItem Header="Settings" Tag="settings" Click="UserMenuItem_Click"/>
                  <MenuItem x:Name="ThemeMenuItem" Header="Dark mode" Tag="theme" Click="UserMenuItem_Click"/>
                  <Separator/>
                  <MenuItem Header="Help" Tag="help" Click="UserMenuItem_Click"/>
                  <Separator/>
                  <MenuItem Header="Sign out" Tag="signout" Click="UserMenuItem_Click"/>
                </ContextMenu>
              </Border.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True"
                        Background="{DynamicResource SideAccent}" Margin="0,0,8,0">
                  <Image x:Name="UserAvatar" Stretch="UniformToFill"/>
                </Border>
                <StackPanel x:Name="UserInfoPanel" VerticalAlignment="Center" MinWidth="0">
                  <TextBlock Text="Stefan Kunc" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource SideFg}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="Online" FontSize="11" Foreground="{DynamicResource AccentGreen}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Sidebar-Listen -->
        <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <StackPanel x:Name="SidebarContentPanel">
            <TextBlock x:Name="PinnedLabel" Text="Pinned" Foreground="{DynamicResource SideFgMuted}"
                       FontSize="11" FontWeight="SemiBold" Margin="12,12,12,4" Opacity="0.45"/>
            <ListBox x:Name="PinnedList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ChannelRow}"
                     ItemTemplate="{StaticResource SidebarItemTemplate}"
                     SelectionChanged="PinnedList_SelectionChanged"/>
            <TextBlock x:Name="GroupsLabel" Text="Gruppe" Foreground="{DynamicResource SideFgMuted}"
                       FontSize="11" FontWeight="SemiBold" Margin="12,12,12,4" Opacity="0.45"/>
            <ListBox x:Name="GroupList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ChannelRow}"
                     ItemTemplate="{StaticResource SidebarItemTemplate}"
                     SelectionChanged="GroupList_SelectionChanged"/>
            <TextBlock x:Name="AgentsLabel" Text="Agents" Foreground="{DynamicResource SideFgMuted}"
                       FontSize="11" FontWeight="SemiBold" Margin="12,12,12,4" Opacity="0.45"/>
            <ListBox x:Name="AgentList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ChannelRow}"
                     ItemTemplate="{StaticResource SidebarItemTemplate}"
                     SelectionChanged="AgentList_SelectionChanged"/>
            <TextBlock x:Name="ChannelsLabel" Text="Channels" Foreground="{DynamicResource SideFgMuted}"
                       FontSize="11" FontWeight="SemiBold" Margin="12,12,12,4" Opacity="0.45"/>
            <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ChannelRow}"
                     ItemTemplate="{StaticResource SidebarItemTemplate}"
                     SelectionChanged="ChannelList_SelectionChanged"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- ===================== MAIN AREA (WebApp + Browser-Split) ===================== -->
    <!-- Body für WebApp-Spalte -->
    <Grid Grid.Row="1" Grid.Column="1" x:Name="WebAppRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- MAIN VIEW: WebApp Fullscreen (Default) -->
      <Grid x:Name="MainView">
        <wv2:WebView2 x:Name="WebAppView"/>
        <!-- Fallback Pseudo-Views (nur sichtbar wenn WebApp nicht lädt) -->
        <wv2:WebView2 x:Name="MessagesView" Visibility="Collapsed"/>
        <wv2:WebView2 x:Name="WorkspaceView" Visibility="Collapsed"/>
        <wv2:WebView2 x:Name="CompanyView" Visibility="Collapsed"/>
        <!-- BrowserPane wird in BrowserSplitColumn angezeigt, nicht hier -->
      </Grid>

      <!-- FLOATING TOGGLE: Side-Browser ein/aus.
           Großer Anker-Button am RECHTEN Rand der WebApp-Spalte (Hidden) oder am
           LINKEN Rand des Split-Browsers (Split). Bleibt immer sichtbar (Opacity
           0.85), beim Hover voll präsent (1.0). Klar lesbares Label "Browser" +
           Icon, sodass der User jederzeit erkennt, dass hier ein Side-Browser
           auf-/zugeklappt werden kann. -->
      <Border x:Name="SideToggleFloat"
              HorizontalAlignment="Right" VerticalAlignment="Center"
              Margin="0,0,8,0" Cursor="Hand"
              Background="{DynamicResource BrowserPaneBg}"
              BorderBrush="{DynamicResource SideAccent}" BorderThickness="1"
              CornerRadius="12" Padding="0"
              Width="38" Height="118"
              ToolTip="Side-Browser öffnen / schließen (Ctrl+Alt+B)"
              MouseLeftButtonUp="BtnToggleBrowserSplit_Click"
              MouseEnter="SideToggleFloat_MouseEnter"
              MouseLeave="SideToggleFloat_MouseLeave">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Icon: dreht sich je nach Mode -->
            <Path x:Name="SideToggleIcon"
                  Width="18" Height="18"
                  Stroke="{DynamicResource SideFg}" StrokeThickness="1.75"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Fill="Transparent"
                  Data="M 4,4 H 20 A 2.5,2.5 0 0 1 22.5,6.5 V 17.5 A 2.5,2.5 0 0 1 20,20 H 4 A 2.5,2.5 0 0 1 1.5,17.5 V 6.5 A 2.5,2.5 0 0 1 4,4 Z M 16,4 V 20"
                  SnapsToDevicePixels="True"
                  HorizontalAlignment="Center">
              <Path.RenderTransform>
                <RotateTransform x:Name="SideToggleRotate" Angle="180"/>
              </Path.RenderTransform>
            </Path>
            <!-- TextLabel: klar lesbar, rotiert mit Icon -->
            <TextBlock x:Name="SideToggleLabel"
                       Margin="0,8,0,0"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SideFg}"
                       HorizontalAlignment="Center">
              <TextBlock.RenderTransform>
                <RotateTransform x:Name="SideToggleLabelRotate" Angle="180"/>
              </TextBlock.RenderTransform>
              <Run Text="B"/><Run Text="R"/><Run Text="O"/><Run Text="W"/><Run Text="S"/><Run Text="E"/><Run Text="R"/>
            </TextBlock>
            <!-- Trennlinie / Status-Punkt -->
            <Border x:Name="SideToggleDot"
                    Margin="0,10,0,0"
                    Width="6" Height="6"
                    CornerRadius="3"
                    Background="{DynamicResource AccentGreen}">
              <Border.RenderTransform>
                <RotateTransform x:Name="SideToggleDotRotate" Angle="180"/>
              </Border.RenderTransform>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== SPLITTER (zwischen WebApp und Side-Browser) ===================== -->
    <GridSplitter Grid.Row="1" Grid.Column="2" x:Name="BrowserSplitter"
                  Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="Transparent"
                  ShowsPreview="True" PreviewStyle="{x:Null}"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"
                  DragCompleted="BrowserSplitter_DragCompleted"
                  Visibility="Collapsed">
      <GridSplitter.Template>
        <ControlTemplate TargetType="GridSplitter">
          <Grid x:Name="SplitterGrid" Background="Transparent">
            <Rectangle x:Name="Grip" Width="1" HorizontalAlignment="Center"
                       Fill="{DynamicResource SideBorder}" Opacity="0.0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Grip" Property="Opacity" Value="0.6"/>
              <Setter TargetName="Grip" Property="Width" Value="2"/>
              <Setter TargetName="Grip" Property="Fill" Value="{DynamicResource SideFgMuted}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </GridSplitter.Template>
    </GridSplitter>

    <!-- ===================== ECHTER BROWSER (Split-Column, Default 0px) ===================== -->
    <Grid Grid.Row="1" Grid.Column="3" x:Name="BrowserSplitRoot"
          Background="{DynamicResource BrowserPaneBg}"
          Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource ToolbarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="6,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnBack"    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3" Click="BtnBack_Click">
              <Path Width="12" Height="12" Stroke="{DynamicResource SideFgMuted}" StrokeThickness="1.75"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                    Data="M5 12l14 0 M11 18l-6-6l6-6" SnapsToDevicePixels="True"/>
            </Button>
            <Button x:Name="BtnForward" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3" Click="BtnForward_Click">
              <Path Width="12" Height="12" Stroke="{DynamicResource SideFgMuted}" StrokeThickness="1.75"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                    Data="M5 12l14 0 M13 6l6 6l-6 6" SnapsToDevicePixels="True"/>
            </Button>
          </StackPanel>
          <TextBox Grid.Column="1" x:Name="SplitAddressBar"
                   Background="{DynamicResource SideRowHover}" BorderThickness="0"
                   Padding="8,4" Foreground="{DynamicResource SideFg}"
                   CaretBrush="{DynamicResource SideAccent}"
                   FontSize="11" VerticalContentAlignment="Center"
                   Margin="6,0" KeyDown="SplitAddressBar_KeyDown"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnSideFullscreen"
                    Click="BtnFullscreen_Click" ToolTip="Side-Browser in Fullscreen (F11)"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5"
                    Width="26" Height="26">
              <Path Width="13" Height="13"
                    Stroke="{DynamicResource SideFgMuted}" StrokeThickness="1.75"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Fill="Transparent"
                    Data="M2.5 5.5 V2.5 H5.5 M10.5 5.5 V2.5 H7.5 M2.5 10.5 V13.5 H5.5 M10.5 10.5 V13.5 H7.5"
                    SnapsToDevicePixels="True">
                <Path.Style>
                  <Style TargetType="Path">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource SideFg}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Button>
            <Rectangle Width="1" Height="14" Margin="2,0" Fill="{DynamicResource SideBorder}"/>
            <Button x:Name="BtnSideClose"
                    Click="BtnToggleBrowserSplit_Click" ToolTip="Side-Browser einklappen (Strg+B)"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5"
                    Width="26" Height="26">
              <Path Width="13" Height="13"
                    Stroke="{DynamicResource SideFgMuted}" StrokeThickness="1.75"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Fill="Transparent"
                    Data="M3 3 L13 13 M13 3 L3 13"
                    SnapsToDevicePixels="True">
                <Path.Style>
                  <Style TargetType="Path">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="Stroke" Value="#EF4444"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" x:Name="BrowserSplitHost" Background="{DynamicResource BrowserPaneBg}">
        <wv2:WebView2 x:Name="SplitWebView" Visibility="Collapsed"/>
        <!-- Kein XAML-Overlay mehr: die Empty-Karte kommt aus dem WebView selbst
             (siehe SplitEmptyHome()) und passt sich automatisch an BrowserPaneBg an.
             Damit verschwindet der leere weiße Streifen im Light-Theme. -->
      </Grid>
    </Grid>

    <!-- ===================== BOTTOM BAR (nur Status, kein Toggle) ===================== -->
    <Border Grid.Row="2" Grid.ColumnSpan="4"
            x:Name="BottomBar"
            Background="{DynamicResource Background}"
            BorderBrush="{DynamicResource SideBorder}"
            BorderThickness="0,1,0,0" Padding="8,4">
      <TextBlock x:Name="BottomStatusText"
                 Text="" FontSize="11"
                 Foreground="{DynamicResource SideFgMuted}"
                 VerticalAlignment="Center" Margin="4,0,0,0"/>
    </Border>
  </Grid>
</Window>
