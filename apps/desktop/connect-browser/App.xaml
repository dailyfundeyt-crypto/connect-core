    <SolidColorBrush x:Key="SideBorder"   Color="#1F2937"/>
    <SolidColorBrush x:Key="SideRowHover" Color="#1F2937"/>
    <SolidColorBrush x:Key="SideRowActive" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="AccentGreen"  Color="#10B981"/>
    <SolidColorBrush x:Key="Primary"      Color="#EAEAEA"/>
    <SolidColorBrush x:Key="PrimaryFg"    Color="#0A0A0A"/>

