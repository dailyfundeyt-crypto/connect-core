    <SolidColorBrush x:Key="Foreground"   Color="#F4F4F5"/>
    <SolidColorBrush x:Key="Border"       Color="#1F2937"/>
    <SolidColorBrush x:Key="StatusBarBg"  Color="#0F172A"/>
    <SolidColorBrush x:Key="StatusFg"     Color="#A1A1AA"/>
