    <SolidColorBrush x:Key="BrowserPaneBg" Color="#000000"/>
    <SolidColorBrush x:Key="SideBg"       Color="#0F172A"/>
    <SolidColorBrush x:Key="SideFg"       Color="#F4F4F5"/>
    <SolidColorBrush x:Key="SideFgMuted"  Color="#71717A"/>
    <SolidColorBrush x:Key="SideFgSofter" Color="#A1A1AA"/>
