<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetPlatformMinVersion>7.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Connect Desktop</AssemblyName>
    <RootNamespace>ConnectDesktop</RootNamespace>
    <ApplicationTitle>Connect</ApplicationTitle>
    <Product>Connect Desktop</Product>
    <AssemblyTitle>Connect</AssemblyTitle>
    <Description>Connect Desktop mit integriertem AI-Browser (WebView2)</Description>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tabler-Icons als Content: werden beim Build nach bin/Release/.../Icons/ kopiert -->
    <None Update="Icons\**\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
