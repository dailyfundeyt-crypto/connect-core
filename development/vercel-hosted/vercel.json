{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "bunVersion": "1.x",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": { "maxDuration": 300, "memory": 1024, "includeFiles": "tenant/**" }
  },
  "rewrites": [
    { "source": "/api/anchor/:path*", "destination": "https://api.anchorbrowser.io/v1/:path*" },
    { "source": "/api/manus/:path*", "destination": "https://api.manus.ai/v2/:path*" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
