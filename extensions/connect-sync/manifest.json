{
  "manifest_version": 3,
  "name": "Connect Sync",
  "short_name": "Connect Sync",
  "version": "1.0.0",
  "description": "Verbindet Helium automatisch mit deiner lokalen Connect App (127.0.0.1:3101): Tabs live aufs Handy, Befehle vom Handy (öffnen, schließen, aktivieren, neu laden, navigieren, Fenster fokussieren).",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1:3101/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Connect Sync",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
